<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tienda de Computadoras</title>
  <link rel="stylesheet" href="/css/products.css">
  <link rel="stylesheet" href="/css/cart.css">
</head>
<body class="bg-light">
  <button class="cart-floating-button" id="cart-button" type="button" data-auth="true" aria-label="Abrir carrito">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="9" cy="21" r="1"></circle>
      <circle cx="20" cy="21" r="1"></circle>
      <path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L23 6H6"></path>
    </svg>
    <span class="cart-count" id="cart-count">0</span>
  </button>
  <div class="cart-overlay" id="cart-overlay"></div>
  <aside class="cart-panel" id="cart-panel" aria-hidden="true">
    <div class="cart-panel-header">
      <h2 class="cart-panel-title">Mi carrito</h2>
      <button class="cart-close-button" id="cart-close" type="button" aria-label="Cerrar carrito">x</button>
    </div>
    <div class="cart-items" id="cart-items"></div>
    <div class="cart-panel-footer">
      <div class="cart-total"><span>Total</span><span id="cart-total">$0.00</span></div>
      <button class="cart-clear-button" id="cart-clear" type="button">Vaciar carrito</button>
    </div>
  </aside>
  <a href="/current" class="btn-perfil">Volver al perfil</a>
  <main class="container my-5">
    <h2 class="text-center mb-4">Nuestros Productos</h2>
    <div class="row g-4">

    <div id="product-list">
      {{#each products}}
      
         <div class="col-md-4">
          <div class="card h-100 shadow-sm">
            <img src="{{this.thumbnail}}" 
                 class="card-img-top" alt="{{this.title}}">
            <div class="card-body">
              <h5 class="card-title">{{this.title}}</h5>
              <p class="card-text">{{this.description}}</p>
              <p class="fw-bold text-success">${{this.price}}</p>
              <a href="#" class="btn btn-primary w-100 add-to-cart" data-id="{{this._id}}">Agregar al Carrito</a>
            </div>
          </div>
        </div> 
    
      {{/each}}
      
    <div class="paginacion">
      <a href="/products?page=1">Página 1.</a>
    
      {{#if hasPrevPage}}
        <a href="/products?page={{prevPage}}">Pág.Anterior.</a>
      {{/if}}

      {{#if hasNextPage}}
        <a href="/products?page={{nextPage}}">Pág. Siguiente</a>
      {{/if}}

      <a href="/products?page={{totalPages}}">Última página</a>
    </div>
      
    </div>
    
  <form id="form-product" class="d-flex flex-column gap-3 p-4 shadow rounded bg-light">
    <input type="text" id="title" placeholder="Nombre del producto" required>
    <input type="number" id="price" placeholder="Precio" required>
    <button type="submit" class="btn btn-success w-100 fw-bold">Agregar</button>
  </form>

    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-dark text-white text-center py-3 mt-5">
    <p class="mb-0">&copy; 2025 TechStore. Todos los derechos reservados.</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/cart.js"></script>
  <script src="/js/realTime.js"></script>

</body>
</html>
